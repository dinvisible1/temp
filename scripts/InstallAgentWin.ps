# Prompt for credentials
$Credential = Get-Credential

# Define variables
$SharePath = "\\192.168.15.165\Agent"
$InstallerName = "so-elastic-agent_windows_amd64.exe"
$LocalTempPath = "$env:TEMP\$InstallerName"
$RemoteTempPath = "C:\Windows\Temp\$InstallerName"
$ServerList = Get-Content -Path "C:\Users\soc.analyst2\Desktop\Agent\servers.txt"

# Step 1: Map and copy the installer to local machine (once)
New-PSDrive -Name Z -PSProvider FileSystem -Root $SharePath -Credential $Credential -Persist

try {
    if (-Not (Test-Path $LocalTempPath)) {
        Write-Host "Copying installer from share to local TEMP..." -ForegroundColor Yellow
        Copy-Item "Z:\$InstallerName" -Destination $LocalTempPath -Force
    }
}
finally {
    Remove-PSDrive -Name Z -ErrorAction SilentlyContinue
}

# Step 2: Loop through each server
foreach ($Server in $ServerList) {
    Write-Host "`nProcessing $Server..." -ForegroundColor Cyan

    try {
        # Create a PowerShell session
        $Session = New-PSSession -ComputerName $Server -Credential $Credential

        # Copy the installer to the remote server
        Copy-Item -Path $LocalTempPath -Destination $RemoteTempPath -ToSession $Session -Force

        # Run the installer remotely
        Invoke-Command -Session $Session -ScriptBlock {
            Start-Process -FilePath "C:\Windows\Temp\so-elastic-agent_windows_amd64.exe" -ArgumentList "/S" -Wait -NoNewWindow
        }

        Write-Host "✅ Installed on $Server" -ForegroundColor Green

        # Clean up session
        Remove-PSSession $Session
    }
    catch {
        Write-Host "❌ Failed on $Server: $_" -ForegroundColor Red
    }
}
