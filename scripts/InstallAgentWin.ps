# Hardcoded credentials
$username = "administrator"
$password = ConvertTo-SecureString "Saf3M0d3PAssw0rd" -AsPlainText -Force
$credential = New-Object System.Management.Automation.PSCredential ($username, $password)

# Elastic Agent share path
$installerPath = "\\192.168.15.165\Agent\so-elastic-agent_windows_amd64.exe"
$installerArgs = "/S"  # Adjust this if a different silent install flag is required

# Load IPs from file
$serverList = Get-Content -Path "C:\Users\soc.analyst2\Desktop\Agent\servers.txt"

foreach ($server in $serverList) {
    Write-Host "Connecting to $server..."

    try {
        # Test if the server is reachable
        if (Test-Connection -ComputerName $server -Count 1 -Quiet) {

            # Run the installer remotely
            Invoke-Command -ComputerName $server -Credential $credential -ScriptBlock {
                $installer = "\\192.168.15.165\Agent\so-elastic-agent_windows_amd64.exe"
                if (Test-Path $installer) {
                    Write-Output "Installer found. Starting installation..."
                    Start-Process -FilePath $installer -ArgumentList "/S" -Wait -NoNewWindow
                } else {
                    Write-Output "Installer path not accessible from remote machine."
                }
            }

            Write-Host "Installer executed on $server"
        } else {
            Write-Host "Server $server is unreachable."
        }
    }
    catch {
        Write-Host "Failed on $server: $_"
    }
}
