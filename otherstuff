#!/bin/bash
# === SYSTEM HARDENING SCRIPT FOR LINUX ===

# 1. Update system
apt update && apt upgrade -y

# 2. Enable UFW firewall
ufw default deny incoming
ufw default allow outgoing
ufw allow ssh
ufw enable

# 3. Disable root SSH login
sed -i 's/^PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
systemctl restart sshd

# 4. Set strong password policy
apt install libpam-pwquality -y
echo 'password requisite pam_pwquality.so retry=3 minlen=12 ucredit=-1 lcredit=-1 dcredit=-1' >> /etc/pam.d/common-password

# 5. Enable automatic updates
apt install unattended-upgrades -y
dpkg-reconfigure --priority=low unattended-upgrades

# 6. Set audit rules
apt install auditd -y
auditctl -e 1

# 7. Remove unnecessary packages (example)
apt purge telnet rsh-server xinetd -y

# 8. Create a non-root admin
adduser socadmin
usermod -aG sudo socadmin

