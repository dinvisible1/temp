# === SYSTEM HARDENING SCRIPT FOR WINDOWS ===

# Run as Administrator!

# 1. Enable Windows Firewall
Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True

# 2. Disable SMBv1 (legacy protocol)
Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -NoRestart

# 3. Disable guest account
Net user guest /active:no

# 4. Enable Windows Defender
Set-MpPreference -DisableRealtimeMonitoring $false

# 5. Enable SmartScreen
Set-MpPreference -EnableNetworkProtection Enabled

# 6. Configure password policy
secedit /export /cfg C:\secpol.cfg
(gc C:\secpol.cfg).replace("MinimumPasswordLength = 0","MinimumPasswordLength = 12") |
  Out-File C:\secpol.cfg
secedit /configure /db secedit.sdb /cfg C:\secpol.cfg

# 7. Disable RDP if not needed
Set-ItemProperty -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" -Name "fDenyTSConnections" -Value 1

# 8. Enable Windows Update
Set-Service -Name wuauserv -StartupType Automatic
Start-Service wuauserv

# 9. Set auditing policy
auditpol /set /subcategory:"Logon" /success:enable /failure:enable
auditpol /set /subcategory:"Object Access" /success:enable /failure:enable
auditpol /set /subcategory:"Privilege Use" /success:enable /failure:enable
